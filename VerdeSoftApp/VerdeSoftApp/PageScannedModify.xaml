<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:d="http://xamarin.com/schemas/2014/forms/design"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:VerdeSoftApp"
             mc:Ignorable="d"
             x:Class="VerdeSoftApp.PageScannedModify">
    <ContentPage.Content>
        <StackLayout>

            <Label x:Name="LabelTitle" HorizontalTextAlignment="Center" TextColor="White" BackgroundColor="Green">Wijzigen</Label>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition Height="45" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>


                <Label x:Name="LabelQuantity" FontSize="12" Text="Aantal" Grid.Row="0" Grid.Column="1" VerticalOptions="Center"/>
                <Label x:Name="LabelPrice" FontSize="12" Text="Prijs" Grid.Row="0" Grid.Column="2" VerticalOptions="Center"/>
                <Label x:Name="LabelDiscount" FontSize="12" Text="Korting" Grid.Row="0" Grid.Column="3" VerticalOptions="Center"/>

                <Frame Grid.Row="1" Grid.Column="1" BorderColor="Gray" CornerRadius="5" Padding="2">
                    <local:NumericEntry x:Name="EntryQuantity" FontSize="14" Grid.Row="1" Grid.Column="1" Placeholder="Quantity" PlaceholderColor="Olive" 
                       Focused="EntryQuantity_Focused" Unfocused="EntryQuantity_Unfocused"  Completed="EntryQuantity_Completed" HorizontalTextAlignment="End" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <local:NumericValidationBehavior />
                        </Entry.Behaviors>
                    </local:NumericEntry>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="2" BorderColor="Gray" CornerRadius="5" Padding="2">
                    <local:NumericEntry x:Name="EntryPrice" FontSize="14" Grid.Row="1" Grid.Column="2" Placeholder="Price" PlaceholderColor="Olive" 
                           Focused="EntryPrice_Focused" Unfocused="EntryPrice_Unfocused" Completed="EntryPrice_Completed" HorizontalTextAlignment="End" Keyboard="Numeric" >
                        <Entry.Behaviors>
                            <local:NumericValidationBehavior />
                        </Entry.Behaviors>
                    </local:NumericEntry>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="3" BorderColor="Gray" CornerRadius="5" Padding="2">
                    <local:NumericEntry x:Name="EntryDiscount" FontSize="14" Grid.Row="1" Grid.Column="3" Placeholder="Reduction" PlaceholderColor="Olive" 
                           Focused="EntryDiscount_Focused" Unfocused="EntryDiscount_Unfocused" Completed="EntryDiscount_Completed" HorizontalTextAlignment="End" Keyboard="Numeric">
                        <Entry.Behaviors>
                            <local:NumericValidationBehavior />
                        </Entry.Behaviors>
                    </local:NumericEntry>
                </Frame>
            </Grid>

            <Label x:Name="LabelArtName" FontSize="16" Text="" HorizontalTextAlignment= "Center" TextColor="Green"/>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnReturn" Text = "Terug"  BackgroundColor="Green" TextColor="White" Clicked="BtnReturn_Clicked" Grid.Row="0" Grid.Column="1"></Button>
                <Button x:Name="BtnSave" Text ="Opslaan"  BackgroundColor="Green" TextColor="White" Clicked= "BtnSave_Clicked" Grid.Row="0" Grid.Column="2"></Button>

            </Grid>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>